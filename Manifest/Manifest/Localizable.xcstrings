          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu selección está guardada, pero las apps no se bloquearán hasta que actives Tiempo de uso en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
