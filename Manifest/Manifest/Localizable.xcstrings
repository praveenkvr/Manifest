    "Plays softly in the background during your ritual. “Random” picks a different one each session." : {
      "comment" : "A description of the ambient sound feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُشغَّل بهدوء في الخلفية أثناء طقسك. يختار “عشوائي” صوتًا مختلفًا في كل جلسة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt während deines Rituals leise im Hintergrund. „Zufällig“ wählt bei jeder Sitzung einen anderen Klang."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena suavemente de fondo durante tu ritual. “Aleatorio” elige uno diferente en cada sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue doucement en arrière-plan pendant votre rituel. «Aléatoire» en choisit un différent à chaque séance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके रिचुअल के दौरान धीरे से पृष्ठभूमि में बजता है। “रैंडम” हर सेशन में एक अलग ध्वनि चुनता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona dolcemente in sottofondo durante il tuo rituale. “Casuale” ne sceglie uno diverso a ogni sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リチュアル中に静かに背景で再生されます。“ランダム”はセッションごとに違う音を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리추얼 동안 배경에서 부드럽게 재생돼요. “무작위”는 세션마다 다른 소리를 선택해요."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca suavemente em segundo plano durante o seu ritual. “Aleatório” escolhe um diferente a cada sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тихо звучит на фоне во время ритуала. «Случайно» выбирает новый звук для каждой сессии."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的仪式中轻柔地在背景播放。“随机”会在每次会话中选择不同的声音。"
          }
        }
      }
    },
