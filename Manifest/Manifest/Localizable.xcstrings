    "“My hands know this work. Every piece I make finds the person it was meant for.”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« يداي تعرفان هذا العمل. كل قطعة أصنعها تجد الشخص الذي صُنعت من أجله. »"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Meine Hände kennen dieses Handwerk. Jedes Stück, das ich mache, findet den Menschen, für den es bestimmt ist.“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Mis manos conocen este oficio. Cada pieza que hago encuentra a la persona para quien fue destinada.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Mes mains connaissent ce travail. Chaque pièce que je crée trouve la personne à qui elle était destinée. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“मेरे हाथ इस काम को जानते हैं। मैं जो भी टुकड़ा बनाता हूं, वह उस व्यक्ति तक पहुंचता है जिसके लिए वह बना था।”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Le mie mani conoscono questo lavoro. Ogni pezzo che creo trova la persona a cui era destinato.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「私の手はこの仕事を知っている。作る一つひとつの作品が、それを必要とする人に届く。」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“내 손은 이 일을 알고 있어요. 내가 만드는 모든 작품은 그것을 위한 사람을 찾아가요.”"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Minhas mãos conhecem este trabalho. Cada peça que faço encontra a pessoa para quem foi destinada.”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Мои руки знают это ремесло. Каждое изделие находит того, для кого оно предназначено.»"
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我的双手懂得这门手艺。我做的每一件作品，都能找到属于它的人。”"
          }
        }
      }
    },
