    "Your picks are saved, but apps won't actually lock until you enable Screen Time in Settings." : {
      "comment" : "A description of the limitations of using Screen Time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ اختياراتك، لكن التطبيقات لن تُقفل فعليًا حتى تفعّل وقت الشاشة في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
