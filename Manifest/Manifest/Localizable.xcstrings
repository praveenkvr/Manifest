    "Stay locked past the window, not just during it" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى مقفلًا حتى بعد انتهاء النافذة، وليس فقط أثناءها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt über das Zeitfenster hinaus gesperrt, nicht nur währenddessen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanece bloqueado después de la ventana, no solo durante ella"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste verrouillé au-delà de la fenêtre, pas seulement pendant"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विंडो के दौरान ही नहीं, उसके बाद भी लॉक रहता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta bloccato oltre la finestra, non solo durante"
          }
        },
